body {
    background-color: rgba(55, 127, 190, 0.432);
    display: flex;
    flex-wrap: wrap;
    
}

.card {
    background-color: white;
    height: 35%;
    width: 35%;
    border-radius: 25px;
    padding: 20px;
}

.botao {
    background-color: rgb(0, 140, 255);
    text-align: center;
    color: aliceblue;
    width: 100%;
    height: 30px;
    border-radius: 5px;
}